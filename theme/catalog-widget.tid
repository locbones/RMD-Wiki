  Catalog.prototype.update=function () {
    var query=this.query.toLowerCase(), self=this;
    var rows=this.records.filter(function(record){
      if(!self.includeDisabled&&!record.enabled)return false;
      if(self.category!=='all'&&record.category!==self.category)return false;
      if(self.tier&&record.tier!==self.tier&&!(record.items||[]).some(function(item){return item.tier===self.tier;}))return false;
      return !query||(record.search||record.name).toLowerCase().indexOf(query)!==-1;
    });
    rows.sort(function(a,b){return self.sort==='name'?a.name.localeCompare(b.name):(Number(a[self.sort]||0)-Number(b[self.sort]||0)||a.name.localeCompare(b.name));});
    var size=this.kind==='sets'?4:this.kind==='runewords'?10:24;
    var total=Math.max(1,Math.ceil(rows.length/size));this.page=Math.min(this.page,total-1);
    var start=this.page*size,end=Math.min(start+size,rows.length);
    this.count.textContent=rows.length?'Showing '+(start+1)+'–'+end+' of '+rows.length+' · Page '+(this.page+1)+' of '+total:'No matching items';
    while(this.results.firstChild)this.results.removeChild(this.results.firstChild);
    rows.slice(start,end).forEach(function(record){self.drawRecord(record,self.results);});
    while(this.pager.firstChild)this.pager.removeChild(this.pager.firstChild);
    [['Previous',-1],['Next',1]].forEach(function(entry){
      var button=element(self.document,'button','rmd-catalog-button',entry[0]);button.setAttribute('type','button');button.disabled=entry[1]<0?self.page===0:self.page===total-1;
      button.addEventListener('click',function(){self.page+=entry[1];self.update();self.count.scrollIntoView({block:'start',behavior:'auto'});});self.pager.appendChild(button);
    });
  };
  Catalog.prototype.refresh=function(changedTiddlers) {
    var attributes=this.computeAttributes();
    if(attributes.kind||attributes.ids||changedTiddlers[this.dataTitle]||changedTiddlers['$:/rmd/item-data/bases']||changedTiddlers['$:/rmd/item-data/definitions']){this.refreshSelf();return true;}
    return false;
  };
  Catalog.controlId=0;
  Catalog.statId=0;
  exports['rmd-catalog']=Catalog;
  exports['rmd-item']=Catalog;
})();
