      if(variant)assumptions.push(base.name+' normal base','Includes socketed rune bonuses');
      if(variant?.forging.length)assumptions.push('Before runic forging');
      if(variant?.runic)assumptions.push('Random jewel affixes excluded');
      if(record.kind==='setitems')assumptions.push('Without conditional set bonuses');
      if(calculated.dependencies.length)assumptions.push(calculated.dependencies.map(function(key){return (key==='level'?'Level':key.charAt(0).toUpperCase()+key.slice(1))+' '+context[key];}).join(' · '));
      output.appendChild(element(self.document,'p','rmd-catalog-calculation-note',assumptions.join(' · ')));
      calculated.notes.forEach(function(note){output.appendChild(element(self.document,'p','rmd-catalog-calculation-note',note));});
    }
    draw();
    if(initial.dependencies.length) {
      var settings=element(this.document,'details','rmd-catalog-inherent');settings.appendChild(element(this.document,'summary','','Adjust character scaling'));
      var fields=element(this.document,'div','rmd-catalog-scaling-fields');
      initial.dependencies.forEach(function(key){
        var label=element(self.document,'label','',key==='level'?'Character level':key.charAt(0).toUpperCase()+key.slice(1)),input=element(self.document,'input','');
        input.type='number';input.min=key==='level'?'1':'0';input.max=key==='level'?'255':'10000';input.step='1';input.value=String(context[key]);input.setAttribute('inputmode','numeric');
        input.addEventListener('input',function(){context[key]=Math.max(Number(input.min),Math.min(Number(input.max),Math.trunc(Number(input.value)||Number(input.min))));draw();});
