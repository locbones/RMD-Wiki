  };
  Catalog.prototype.calculatedValue=function(stat,label,value) {
    var self=this,button=element(this.document,'button','rmd-catalog-stat-value',stat.value),tooltip=element(this.document,'span','rmd-catalog-stat-tooltip'),timer;
    var id='rmd-stat-calculation-'+(++Catalog.statId);
