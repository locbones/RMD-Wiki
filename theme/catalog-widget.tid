  Catalog.prototype.equipmentPreview=function (record,parent,variant) {
    var base=this.baseRecords.get(variant?variant.exampleBase?.code:record.code);
    if(!base||variant&&!variant.exampleBase.compatible)return;
    var properties=(variant?variant.properties:record.properties||[]).map(function(p){return Object.assign({},p,{calculationSource:record.name});});
    if(variant) {
