      variant.runes.forEach(function(rune){(rune.socketBonuses||[]).filter(function(b){return b.context===socketContext;}).forEach(function(b){properties=properties.concat(b.properties.map(function(p){return Object.assign({},p,{calculationSource:rune.name});}));});});
