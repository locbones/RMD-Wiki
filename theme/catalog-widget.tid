    this.records=this.wiki.getTiddlerData(this.dataTitle,{records:[]}).records||[];
    this.definitions=this.wiki.getTiddlerData('$:/rmd/item-data/definitions',{autoAffixes:{},properties:{},stats:{}});
    this.baseRecords=new Map((this.wiki.getTiddlerData('$:/rmd/item-data/bases',{records:[]}).records||[]).map(function(r){return [r.code,r];}));
  };
  Catalog.prototype.image=function (record,parent) {
