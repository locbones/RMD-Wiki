  [0,.5,1].forEach(function(f){shape('text',{x:100+402*f,y:212,'text-anchor':f===0?'start':f===1?'end':'middle',fill:'#bba483','font-size':11},num(f*horizon/(time?60:1))+(time?' h':' runs'));});
