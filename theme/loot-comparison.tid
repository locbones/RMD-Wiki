    if(r.samples){el(h,box,'p','rmd-lt-small','Middle 80% of maps: '+range(r.killsRange,num)+' kills · '+range(r.chanceRange,pct)+' drop chance.');var c=r.components;el(h,box,'p','rmd-lt-small',num(c.ordinary)+' ordinary · '+num(c.champion+c.unique)+' random elites · '+num(c.minion)+' elite minions · '+num(c.fixed)+' fixed encounters.');}
    var details=el(h,box,'details','rmd-lc-pool');el(h,details,'summary','','Kills by monster');r.mix.forEach(function(m){el(h,details,'p','rmd-lt-small',(h.sourceMap.get(m.id)?.name||h.data.spawnMonsters[m.id]?.name||m.id)+' · '+num(m.kills)+' kills / run');});
  });
