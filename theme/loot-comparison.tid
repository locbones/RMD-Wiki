    var faster=a.expectedMinutes<=b.expectedMinutes?'A':'B',fast=faster==='A'?a:b,slow=faster==='A'?b:a,timeSaving=(1-fast.expectedMinutes/slow.expectedMinutes)*100;
    el(h,verdict,'p','',timeSaving<.05?'Expected time is about equal at your selected pace.':'Route '+faster+' takes about '+num(timeSaving)+'% less expected time at your selected pace.');
  }else el(h,verdict,'p','','Both routes need supported, positive drop chances for an efficiency comparison.');
