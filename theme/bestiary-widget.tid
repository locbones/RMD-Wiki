    var selected=this.area&&available.includes(this.area)?this.area:available[0]||'';
    var context=node(this.document,'div','rmd-be-context');card.appendChild(context);
    this.select(context,'Stats location',[['','Reference level']].concat(available.map(function(id){return [id,self.areaMap[id].name];})),selected,function(value){selected=value;paint();});
