    var records=this.records.filter(function(r){return self.matches(r);}),encounterOrder={};
    records.forEach(function(r){encounterOrder[r.id]=Math.min.apply(null,r.locations.filter(function(l){return l.difficulty===self.difficulty;}).map(function(l){return Number(l.area);}));});
    records.sort(function(a,b){return self.sort==='level'?b.stats[self.difficulty].level-a.stats[self.difficulty].level||a.name.localeCompare(b.name):self.sort==='family'?a.family.localeCompare(b.family)||a.name.localeCompare(b.name):self.sort==='area'?encounterOrder[a.id]-encounterOrder[b.id]||a.name.localeCompare(b.name)||a.id.localeCompare(b.id):a.name.localeCompare(b.name)||a.id.localeCompare(b.id);});
    var totalPages=Math.max(1,Math.ceil(records.length/12));this.page=Math.min(this.page,totalPages-1);
    this.count.textContent=number(records.length)+' entries · '+difficulties[this.difficulty];
    records.slice(this.page*12,this.page*12+12).forEach(function(r){self.card(r,self.grid);});
    if(!records.length)this.grid.appendChild(node(this.document,'p','rmd-be-empty','No monsters match these filters. Try another area or difficulty.'));
    function button(label,disabled,action){var b=node(self.document,'button','rmd-be-button',label);b.disabled=disabled;b.addEventListener('click',action);self.pages.appendChild(b);}
    function move(delta){self.page+=delta;self.results();self.count.scrollIntoView({block:'start',behavior:'auto'});}
    button('Previous',this.page===0,function(){move(-1);});this.pages.appendChild(node(this.document,'span','','Page '+(this.page+1)+' of '+totalPages));button('Next',this.page===totalPages-1,function(){move(1);});
  };
