  Bestiary.prototype.matches=function(r){
    var enemy=['Enemy','Boss','Superunique'].includes(r.role);
    if(this.scope==='enemies'&&(!r.enabled||!enemy))return false;
    if(this.scope==='bosses'&&(!r.enabled||!['Boss','Superunique'].includes(r.role)))return false;
    if(this.scope==='summons'&&(!r.enabled||!['Summon','Ally'].includes(r.role)))return false;
    if(this.scope==='other'&&enemy&&r.enabled)return false;
    if(this.collection==='custom'&&!r.added)return false;
    if(this.collection==='trials'&&!r.locations.some(function(l){return /^Icy Hell|Trials End/.test(this.areaMap[l.area].name);},this)&&!r.placements.some(function(p){return /Icy Hell|Trial/i.test(p.preset);} ))return false;
    if(this.group&&r.group!==this.group)return false;if(this.family&&r.family!==this.family)return false;
    if(this.area&&!r.locations.some(function(l){return l.area===this.area&&l.difficulty===this.difficulty;},this))return false;
    if(this.act&&!r.locations.some(function(l){return this.areaMap[l.area].act===Number(this.act);},this)&&!r.placements.some(function(p){return p.act===Number(this.act);},this))return false;
    if(this.immune!==''&&r.stats[this.difficulty].resists[Number(this.immune)]<100)return false;
    return !this.query||(r.name+' '+r.id+' '+r.family+' '+r.baseName+' '+r.skills.map(function(s){return s.name;}).join(' ')+' '+r.locations.map(function(l){return this.areaMap[l.area].name;},this).join(' ')).toLowerCase().includes(this.query);
  };
  Bestiary.prototype.results=function(){
