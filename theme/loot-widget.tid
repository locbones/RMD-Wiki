      else{var wrap=node(self.document,'span','rmd-lt-loot-name');self.image(wrap,r.item,false);self.button(wrap,r.item.name,function(){self.chooseItem(r.item.id);},'rmd-lt-text-button rmd-lt-'+r.item.kind);name.appendChild(wrap);name.appendChild(node(self.document,'small','rmd-lt-subtext',r.item.code));}
