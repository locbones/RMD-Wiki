  Loot.prototype.numeric=function(parent,label,value,min,max,action){var wrap=node(this.document,'label','rmd-lt-field'),input=node(this.document,'input');wrap.appendChild(node(this.document,'span','',label));input.type='number';input.min=String(min);input.max=String(max);input.step='1';input.value=value;input.inputMode='numeric';input.setAttribute('aria-label',label);input.addEventListener('input',function(){action(input.value);});wrap.appendChild(input);parent.appendChild(wrap);return input;};
