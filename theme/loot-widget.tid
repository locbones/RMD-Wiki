    entries.sort(function(a,b){return (self.pickerSort==='type'?(kindOrder[a.kind]||0)-(kindOrder[b.kind]||0):self.pickerSort==='level'?(b.level||0)-(a.level||0):0)||a.name.localeCompare(b.name)||a.id.localeCompare(b.id);});
