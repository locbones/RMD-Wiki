  Loot.prototype.switchMode=function(mode){this.mode=mode;this.advanced.hidden=mode==='comparison';this.pickerPage=this.resultPage=0;this.resultQuery='';this.tabs.forEach(function(b){b.setAttribute('aria-selected',String(b.dataset.mode===mode));});this.buildPicker();this.update();};
  Loot.prototype.buildPicker=function(){
